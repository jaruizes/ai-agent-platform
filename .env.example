# Required for LiteLLM -> Anthropic
ANTHROPIC_API_KEY=replace-me

# Cheap/fast model used by the intent resolver.
ANTHROPIC_ROUTER_MODEL=anthropic/claude-haiku-4-5-20251001

# General execution model used for DIRECT_LLM and AGENT strategies.
ANTHROPIC_EXECUTION_MODEL=anthropic/claude-sonnet-4-5-20250929

# Local gateway authentication between agent-platform and LiteLLM.
LITELLM_MASTER_KEY=sk-local-dev-key

POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
